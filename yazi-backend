#!/bin/bash
# Yazi backend for MOS.
# The Yazi binaries are installed by the plugin .deb under /usr/lib/yazi.
# Config, data, state, and cache stay in RAM unless an app directory is configured.
# Dependencies are installed in the background because MOS plugin queries
# have a 60 second limit.

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 022

. "${YAZI_ENV:-/usr/share/yazi-plugin/yazi-env}"

PKG_DIR="$YAZI_PLUGIN_DIR/packages"
PID_FILE="$PKG_DIR/.installing"
FAILED_FILE="$PKG_DIR/.failed"
LOG_FILE="$PKG_DIR/install.log"
SHARE_DIR="$YAZI_SHARE_DIR"

CORE_DEPS="file"
SEARCH_DEPS="ripgrep fd-find fzf zoxide jq"
MEDIA_DEPS="ffmpeg poppler-utils p7zip-full imagemagick"
EXTRA_DEPS="resvg udisks2 git zip unzip"
DEPS="$CORE_DEPS $SEARCH_DEPS $MEDIA_DEPS $EXTRA_DEPS"

say() { echo "$*"; }
has_cmd() { command -v "$1" >/dev/null 2>&1; }
cmd_bool() { if has_cmd "$1"; then echo true; else echo false; fi; }

write_default_settings() {
  cat > "$YAZI_SETTINGS" <<'JSON'
{
  "data_dir": ""
}
JSON
}

ensure_settings() {
  mkdir -p "$YAZI_PLUGIN_DIR"
  if command -v jq >/dev/null 2>&1 && [ -f "$YAZI_SETTINGS" ] && ! jq empty "$YAZI_SETTINGS" >/dev/null 2>&1; then
    cp -f "$YAZI_SETTINGS" "$YAZI_SETTINGS.bak.$(date +%s)" 2>/dev/null || true
    rm -f "$YAZI_SETTINGS"
  fi
  if [ ! -f "$YAZI_SETTINGS" ]; then
    if [ -f "$SHARE_DIR/settings.json" ]; then
      cp -f "$SHARE_DIR/settings.json" "$YAZI_SETTINGS"
    else
      write_default_settings
    fi
  fi
}

ensure_dirs() {
  yazi_prepare
  mkdir -p "$PKG_DIR" 2>/dev/null || true
}

current_version() {
  if [ -x "$YAZI_BIN" ]; then
    "$YAZI_BIN" --version 2>/dev/null | awk '/Version:/{print $2; exit}'
  fi
}

dep_command() {
  case "$1" in
    file) echo file ;;
    ripgrep) echo rg ;;
    fd-find) echo fd ;;
    fzf) echo fzf ;;
    zoxide) echo zoxide ;;
    jq) echo jq ;;
    git) echo git ;;
    zip) echo zip ;;
    unzip) echo unzip ;;
    ffmpeg) echo ffmpeg ;;
    poppler-utils) echo pdftoppm ;;
    p7zip-full) echo 7z ;;
    resvg) echo resvg ;;
    imagemagick) echo magick ;;
    udisks2) echo udisksctl ;;
    *) echo "$1" ;;
  esac
}

group_deps() {
  case "$1" in
    core) echo "$CORE_DEPS" ;;
    search) echo "$SEARCH_DEPS" ;;
    media) echo "$MEDIA_DEPS" ;;
    extras) echo "$EXTRA_DEPS" ;;
    all) echo "$DEPS" ;;
    *) return 1 ;;
  esac
}

group_missing() {
  local deps pkg
  deps="$(group_deps "$1")" || return 1
  for pkg in $deps; do
    has_cmd "$(dep_command "$pkg")" || echo "$pkg"
  done
}

missing_deps() {
  has_cmd file || echo file
  has_cmd rg || echo rg
  has_cmd fd || echo fd
  has_cmd fzf || echo fzf
  has_cmd zoxide || echo zoxide
  has_cmd jq || echo jq
  has_cmd ffmpeg || echo ffmpeg
  has_cmd pdftoppm || echo pdftoppm
  has_cmd 7z || echo 7z
  has_cmd magick || echo magick
  has_cmd resvg || echo resvg
  has_cmd git || echo git
  has_cmd udisksctl || echo udisksctl
  has_cmd zip || echo zip
  has_cmd unzip || echo unzip
}

current_boot_id() {
  cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown
}

worker_running() {
  [ -f "$PID_FILE" ] || return 1
  local boot pid
  read -r boot pid < "$PID_FILE" 2>/dev/null || true
  if [ -n "$pid" ] && [ "$boot" = "$(current_boot_id)" ] && kill -0 "$pid" 2>/dev/null; then
    return 0
  fi
  rm -f "$PID_FILE" 2>/dev/null || true
  return 1
}

cmd_prepare() {
  ensure_settings
  ensure_dirs
  return 0
}

cmd_status() {
  local installed=false version config_exists=false installing=false failed=false
  local missing_json="" dep first=true

  ensure_settings
  ensure_dirs

  [ -x "$YAZI_BIN" ] && installed=true
  version="$(current_version)"
  [ -n "$version" ] || version="not installed"

  for f in yazi.toml keymap.toml theme.toml init.lua; do
    if [ -f "$YAZI_CONFIG_ROOT/$f" ]; then
      config_exists=true
      break
    fi
  done

  if worker_running; then
    installing=true
  fi
  [ -f "$FAILED_FILE" ] && failed=true

  local -a missing=()
  while IFS= read -r dep; do
    [ -n "$dep" ] && missing+=("$dep")
  done < <(missing_deps)

  for dep in "${missing[@]}"; do
    if [ "$first" = true ]; then
      first=false
    else
      missing_json+=","
    fi
    missing_json+="\"$dep\""
  done

  printf '{"installed":%s,"version":"%s","app_root":"%s","storage_mode":"%s","config":"%s","config_root":"%s","data":"%s","data_root":"%s","config_exists":%s,"command":"yazi","deps":{"file":%s,"rg":%s,"fd":%s,"fzf":%s,"zoxide":%s,"jq":%s,"ffmpeg":%s,"pdftoppm":%s,"7z":%s,"magick":%s,"resvg":%s,"git":%s,"udisksctl":%s,"zip":%s,"unzip":%s},"missing_deps":[%s],"deps_installing":%s,"deps_failed":%s,"deps_log":"%s"}\n' \
    "$installed" "$version" "$YAZI_APP_ROOT" "$YAZI_STORAGE_MODE" \
    "$YAZI_CONFIG_ROOT" "$YAZI_CONFIG_ROOT" "$YAZI_DATA_ROOT" "$YAZI_DATA_ROOT" "$config_exists" \
    "$(cmd_bool file)" "$(cmd_bool rg)" "$(cmd_bool fd)" "$(cmd_bool fzf)" \
    "$(cmd_bool zoxide)" "$(cmd_bool jq)" "$(cmd_bool ffmpeg)" "$(cmd_bool pdftoppm)" \
    "$(cmd_bool 7z)" "$(cmd_bool magick)" "$(cmd_bool resvg)" "$(cmd_bool git)" \
    "$(cmd_bool udisksctl)" "$(cmd_bool zip)" "$(cmd_bool unzip)" \
    "$missing_json" "$installing" "$failed" "$LOG_FILE"
}

cmd_start_deps_worker() {
  local group="$1"
  local missing
  missing="$(group_missing "$group" | tr '\n' ' ')"
  if [ -z "$missing" ]; then
    rm -f "$FAILED_FILE" 2>/dev/null || true
    say "Dependencies for '$group' are already installed"
    return 0
  fi
  if worker_running; then
    say "Dependency installation is already running"
    return 0
  fi
  rm -f "$FAILED_FILE" 2>/dev/null || true
  if command -v setsid >/dev/null 2>&1; then
    setsid /bin/bash "$0" __install_deps_worker "$group" >/dev/null 2>&1 < /dev/null &
  else
    nohup /bin/bash "$0" __install_deps_worker "$group" >/dev/null 2>&1 < /dev/null &
  fi
  sleep 0.2
  say "Dependency installation started in the background: $group"
}

cmd_install_deps() {
  ensure_settings
  ensure_dirs
  # The boot-time list is only the required package.
  printf '%s\n' $CORE_DEPS > "$PKG_DIR/packages"
  cmd_start_deps_worker core
}

cmd_install_group() {
  ensure_settings
  ensure_dirs
  local group="${1:-}"
  if ! group_deps "$group" >/dev/null 2>&1; then
    echo "Unknown dependency group: $group" >&2
    return 2
  fi
  cmd_start_deps_worker "$group"
}

cmd_install_deps_worker() {
  local group="${1:-core}"
  local deps
  deps="$(group_deps "$group")" || exit 2
  echo "$(current_boot_id) $$" > "$PID_FILE"
  exec >>"$LOG_FILE" 2>&1
  echo "=== Yazi dependencies ($group): $(date -u '+%Y-%m-%dT%H:%M:%SZ')"

  local apt=apt-get
  if command -v apt-get.orig >/dev/null 2>&1; then
    apt=apt-get.orig
  fi

  local rc=0
  rm -f "$PKG_DIR"/*.deb 2>/dev/null || true

  DEBIAN_FRONTEND=noninteractive "$apt" update || rc=1

  install_one() {
    local pkg="$1"
    local -a debs=()
    local f
    rm -f "$PKG_DIR"/*.deb 2>/dev/null || true
    if ! DEBIAN_FRONTEND=noninteractive "$apt" install -y --download-only --no-install-recommends \
      -o Dir::Cache::archives="$PKG_DIR" "$pkg" >/dev/null 2>&1; then
      echo "Download failed: $pkg"
      return 1
    fi
    for f in "$PKG_DIR"/*.deb; do
      [ -f "$f" ] && debs+=("$f")
    done
    if [ ${#debs[@]} -gt 0 ]; then
      if ! dpkg -i "${debs[@]}" >/dev/null 2>&1; then
        echo "dpkg failed: $pkg"
        return 1
      fi
    fi
    echo "Installed: $pkg"
    return 0
  }

  local pkg
  for pkg in $deps; do
    has_cmd "$(dep_command "$pkg")" && continue
    install_one "$pkg" || rc=1
  done

  dpkg --configure -a >/dev/null 2>&1 || true
  ldconfig 2>/dev/null || true

  if ! has_cmd fd && has_cmd fdfind; then
    ln -sf fdfind /usr/bin/fd 2>/dev/null || true
  fi

  local missing
  missing="$(group_missing "$group" | tr '\n' ' ')"
  rm -f "$PID_FILE" 2>/dev/null || true

  if [ -z "$missing" ]; then
    rm -f "$FAILED_FILE" 2>/dev/null || true
    echo "Success: dependencies for '$group' are installed"
    echo "=== finished"
    exit 0
  fi

  printf 'Missing (%s): %s\n' "$group" "$missing" > "$FAILED_FILE"
  echo "Failure: still missing for '$group': $missing"
  echo "=== finished"
  exit 1
}

cmd_uninstall() {
  rm -f /usr/bin/yazi /usr/bin/ya 2>/dev/null || true
  if [ -L /usr/bin/fd ] && [ "$(readlink /usr/bin/fd)" = "fdfind" ]; then
    rm -f /usr/bin/fd 2>/dev/null || true
  fi
  say "Removed Yazi commands. RAM data is discarded; a configured app directory is kept."
}

ensure_settings

case "${1:-}" in
  status) cmd_status ;;
  install_deps) cmd_install_deps ;;
  install_group) cmd_install_group "${2:-}" ;;
  __install_deps_worker) cmd_install_deps_worker "${2:-core}" ;;
  prepare) cmd_prepare ;;
  version) current_version ;;
  uninstall) cmd_uninstall ;;
  *)
    echo "Usage: $0 {status|install_deps|prepare|version|uninstall}" >&2
    exit 2
    ;;
esac