#!/bin/sh
# Shared path resolution for the Yazi MOS plugin.
# No automatic path detection. Persistence is opt-in through one user setting.

YAZI_PLUGIN_DIR="${YAZI_PLUGIN_DIR:-/boot/optional/plugins/yazi}"
YAZI_SETTINGS="${YAZI_SETTINGS:-$YAZI_PLUGIN_DIR/settings.json}"
YAZI_RAM_DIR="${YAZI_RAM_DIR:-/run/yazi}"
YAZI_SHARE_DIR="${YAZI_SHARE_DIR:-/usr/share/yazi-plugin}"
YAZI_BIN="${YAZI_BIN:-/usr/lib/yazi/yazi}"
YAZI_YA_BIN="${YAZI_YA_BIN:-/usr/lib/yazi/ya}"

yazi_setting() {
  [ -f "$YAZI_SETTINGS" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    jq -r --arg k "$1" '.[$k] // empty' "$YAZI_SETTINGS" 2>/dev/null
  else
    sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$YAZI_SETTINGS" | head -n 1
  fi
}

yazi_resolve_paths() {
  local data_setting
  data_setting="$(yazi_setting data_dir)"

  if [ -n "$data_setting" ]; then
    YAZI_APP_ROOT="$data_setting"
    YAZI_STORAGE_MODE="custom"
  else
    YAZI_APP_ROOT="$YAZI_RAM_DIR"
    YAZI_STORAGE_MODE="ram"
  fi

  YAZI_CONFIG_ROOT="$YAZI_APP_ROOT/config"
  YAZI_DATA_ROOT="$YAZI_APP_ROOT/data"
  YAZI_STATE_ROOT="$YAZI_APP_ROOT/state"
  YAZI_CACHE_ROOT="$YAZI_APP_ROOT/cache"
}

yazi_prepare() {
  yazi_resolve_paths
  mkdir -p "$YAZI_CONFIG_ROOT" "$YAZI_DATA_ROOT" "$YAZI_STATE_ROOT" "$YAZI_CACHE_ROOT" 2>/dev/null || true
}