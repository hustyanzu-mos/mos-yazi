#!/bin/sh
# Yazi wrapper for MOS.
# Config and data live on a mounted pool; state and cache live in RAM.

. "${YAZI_ENV:-/usr/share/yazi-plugin/yazi-env}"

if [ ! -x "$YAZI_BIN" ]; then
  echo "Yazi is not installed. Reinstall the Yazi plugin from MOS Hub." >&2
  exit 127
fi

yazi_prepare

export YAZI_CONFIG_HOME="$YAZI_CONFIG_ROOT"
export XDG_DATA_HOME="$YAZI_DATA_ROOT"
export XDG_STATE_HOME="$YAZI_STATE_ROOT"
export XDG_CACHE_HOME="$YAZI_CACHE_ROOT"
export XDG_RUNTIME_DIR="$YAZI_RAM_DIR/runtime"

mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 0700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

exec "$YAZI_BIN" "$@"