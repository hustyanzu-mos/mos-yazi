#!/bin/sh
# Yazi wrapper for MOS.
# Config and data are persistent; state/cache are RAM.

PLG_DIR="${YAZI_PLUGIN_DIR:-/boot/optional/plugins/yazi}"
BIN="${YAZI_BIN:-/usr/lib/yazi/yazi}"
RUNTIME_DIR="${YAZI_RUNTIME_DIR:-/run/yazi}"

if [ ! -x "$BIN" ]; then
  echo "Yazi is not installed. Reinstall the Yazi plugin from MOS Hub." >&2
  exit 127
fi

export YAZI_CONFIG_HOME="$PLG_DIR/config"
export XDG_DATA_HOME="$PLG_DIR/data"
export XDG_STATE_HOME="$RUNTIME_DIR/state"
export XDG_CACHE_HOME="$RUNTIME_DIR/cache"
export XDG_RUNTIME_DIR="$RUNTIME_DIR/runtime"

mkdir -p "$YAZI_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_CACHE_HOME" "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 0700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

exec "$BIN" "$@"